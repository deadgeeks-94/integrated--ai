# Integrated AI configuration template
# Copy to your shell environment or a local .env file and fill in your own values.
# Never commit real keys. Placeholders only below.

# Provider API keys (leave blank if not using that provider)
OPENAI_API_KEY=
# GOOGLE_API_KEY= alternative to GEMINI_API_KEY
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# Model overrides (defaults shown in main.py / README.md)
MODEL_FAST=gpt-4.1-mini
MODEL_STRONG=gpt-4.1
MODEL_GEMINI=gemini-2.5-flash
MODEL_CLAUDE=claude-sonnet-4-5
MODEL_DEEPSEEK=deepseek-chat

# Routing / behavior
PROVIDER=auto
AGENT=general
HOST=0.0.0.0
PORT=8000

# Memory and file limits (MAX_FILE_BYTES caps text fed into a prompt)
MEMORY_FILE=
MEMORY_MAX_TURNS=20
MAX_FILE_BYTES=200000

# Upload limits (image + document uploads). Practical defaults, adjustable:
# - UPLOAD_MAX_BYTES: max size of one uploaded file (50 MB default, configurable)
# - MAX_UPLOAD_FILES: max files per request (10 default)
# - UPLOAD_TOTAL_MAX_BYTES: max combined size per request (200 MB default)
# No arbitrary low cap: raise these as high as your provider and server safely allow.
# Provider/model limits (context window, image rules) still apply on top.
# WORKSPACE_DIR: where generated/downloadable files are stored (default ~/.integrated-ai/workspace)
# Use session_id "project/<name>" for a persistent project conversation + workspace.
# Honest note: these raise only THIS server's limits. Each AI provider has its
# own limits (model context window, image size rules, request caps) and the
# server has safety limits too. No setting here can remove provider limits.
UPLOAD_MAX_BYTES=52428800
MAX_UPLOAD_FILES=10
UPLOAD_TOTAL_MAX_BYTES=209715200
WORKSPACE_DIR=
