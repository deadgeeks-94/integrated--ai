<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <Button
                android:id="@+id/menuButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:backgroundTint="#F2F3F5"
                android:text="☰"
                android:textColor="#202123"
                android:textSize="19sp"
                android:contentDescription="Open navigation menu" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:paddingStart="12dp"
                android:text="Integrated AI"
                android:textColor="#202123"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/clearButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:backgroundTint="#F2F3F5"
                android:text="＋"
                android:textColor="#202123"
                android:textSize="22sp"
                android:contentDescription="New chat" />
        </LinearLayout>

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/status_scaffold"
            android:textColor="#777777"
            android:textSize="10sp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp">

            <Spinner
                android:id="@+id/providerSpinner"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/input_background"
                android:paddingStart="8dp" />

            <Spinner
                android:id="@+id/agentSpinner"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/input_background"
                android:paddingStart="8dp" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/chatRecycler"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/attachedText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_attachments"
            android:textColor="#777777"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="5dp"
            android:paddingBottom="8dp">

            <Button
                android:id="@+id/attachButton"
                android:layout_width="44dp"
                android:layout_height="46dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:backgroundTint="#F1F2F4"
                android:text="＋"
                android:textColor="#202123"
                android:textSize="22sp"
                android:contentDescription="Attach files" />

            <EditText
                android:id="@+id/messageInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minHeight="48dp"
                android:maxHeight="120dp"
                android:layout_marginStart="7dp"
                android:hint="@string/hint_message"
                android:background="@drawable/composer_background"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp"
                android:textSize="14sp"
                android:inputType="textCapSentences|textMultiLine"
                android:gravity="center_vertical" />

            <Button
                android:id="@+id/sendButton"
                android:layout_width="48dp"
                android:layout_height="46dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:layout_marginStart="6dp"
                android:text="↑"
                android:textSize="19sp"
                android:contentDescription="Send message" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="304dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#F7F7F8"
        android:fitsSystemWindows="true"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="18dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_integrated_ai"
                    android:contentDescription="Integrated AI logo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="10dp"
                    android:text="Integrated AI"
                    android:textColor="#202123"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <Button
                android:id="@+id/newChatMenuButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:gravity="start|center_vertical"
                android:text="＋   New chat"
                android:textAllCaps="false"
                android:textColor="#202123" />

            <Button
                android:id="@+id/searchChatsButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:gravity="start|center_vertical"
                android:text="⌕   Search chats"
                android:textAllCaps="false"
                android:textColor="#202123" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:background="#E4E4E7" />

            <Button
                android:id="@+id/imagesButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="start|center_vertical"
                android:text="▧   Images"
                android:textAllCaps="false"
                android:textColor="#202123" />

            <Button
                android:id="@+id/analyzeButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="start|center_vertical"
                android:text="✧   Analyze attachments"
                android:textAllCaps="false"
                android:textColor="#202123" />

            <Button
                android:id="@+id/libraryButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="start|center_vertical"
                android:text="▤   Library"
                android:textAllCaps="false"
                android:textColor="#202123" />

            <Button
                android:id="@+id/customizeButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="start|center_vertical"
                android:text="⚙   Customize"
                android:textAllCaps="false"
                android:textColor="#202123" />

            <Button
                android:id="@+id/projectButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="start|center_vertical"
                android:text="▣   Projects"
                android:textAllCaps="false"
                android:textColor="#202123" />

            <Button
                android:id="@+id/remoteButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="start|center_vertical"
                android:text="⇄   Remote"
                android:textAllCaps="false"
                android:textColor="#202123" />

            <Button
                android:id="@+id/exploreButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="start|center_vertical"
                android:text="⊞   Explore"
                android:textAllCaps="false"
                android:textColor="#202123" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your chats"
                android:textColor="#777777"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingTop="18dp"
                android:paddingBottom="5dp" />

            <Button
                android:id="@+id/memoryButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="start|center_vertical"
                android:text="◷   Chat history"
                android:textAllCaps="false"
                android:textColor="#202123" />

            <Button
                android:id="@+id/workspaceButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="start|center_vertical"
                android:text="▤   Workspace files"
                android:textAllCaps="false"
                android:textColor="#202123" />

            <Button
                android:id="@+id/saveReplyButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="start|center_vertical"
                android:text="↓   Save latest reply"
                android:textAllCaps="false"
                android:textColor="#202123" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="10dp"
                android:background="#E4E4E7" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="BACKEND SETTINGS"
                android:textColor="#777777"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:paddingBottom="7dp" />

            <EditText
                android:id="@+id/backendUrlInput"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:hint="@string/backend_url_hint"
                android:singleLine="true"
                android:inputType="textUri"
                android:textSize="12sp"
                android:padding="9dp"
                android:background="@drawable/input_background" />

            <EditText
                android:id="@+id/accessTokenInput"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:hint="Backend access token"
                android:inputType="textPassword"
                android:autofillHints=""
                android:singleLine="true"
                android:textSize="12sp"
                android:padding="9dp"
                android:background="@drawable/input_background" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/saveUrlButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Save"
                    android:textAllCaps="false" />

                <Button
                    android:id="@+id/checkButton"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="Test"
                    android:textAllCaps="false" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.drawerlayout.widget.DrawerLayout>